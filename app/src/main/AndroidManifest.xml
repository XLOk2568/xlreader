<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      本应用不联网、不采集数据，唯一的敏感权限是「所有文件访问」：
      Android 11（API 30）起，读取 .epub 这类非媒体文件无法靠 READ_EXTERNAL_STORAGE 完成，
      只能走 SAF（Wear OS 没有系统文件选择器）或 MANAGE_EXTERNAL_STORAGE。
      因此这里按文件浏览器类应用的常规做法申请后者，由用户在系统设置里显式授权。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="AllFilesAccessPolicy,ScopedStorage" />

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">
        <!--
          required="false"：不依赖 Google Play 服务的手表（部分国内手表无 GMS）
          也能正常安装运行。
        -->
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!--
               Set to true if your app is Standalone, that is, it does not require the handheld
               app to run.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/MainActivityTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 注册为电子书的打开方式：从文件管理器/其他应用点开 epub 可直接进来阅读。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <!--
              有些来源不会带正确的 MIME，只按扩展名派发，所以再补一条按路径匹配的。
              这里只声明 application/octet-stream，不用 */* —— 否则 XLreader 会出现在
              所有文件类型的「打开方式」里，既打扰用户也不合适。
              scheme 为 file/content 时本来就不存在 host，lint 的 AppLinkUrlError
              是针对 http(s) 深链的，这里显式忽略。
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.epub" />
            </intent-filter>
        </activity>
    </application>

</manifest>
