<resources>

    <!--
      界面主题：关掉系统自带的标题栏。
      Theme.DeviceDefault 在手机等非手表设备上默认带 ActionBar，会在左上角画出应用名
      「XLreader」，看起来像一条顶部标题栏；手表上本来没有，关掉也不影响。
      界面全部由 Compose 自己画，不需要系统标题栏。
    -->
    <style name="MainActivityTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="MainActivityTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/MainActivityTheme</item>
        <!-- 启动窗口也关掉标题栏，冷启动那一下不会先闪一条「XLreader」。 -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
